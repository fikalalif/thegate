{
  "name": "thegate",
  "version": "1.5.0",
  "description": "TheGate — The Control Plane for AI: Intelligent LLM Routing & Operations Cockpit (Native Fastify Engine)",
  "main": "bin/thegate.js",
  "bin": {
    "thegate": "bin/thegate.js"
  },
  "files": [
    "bin/thegate.js",
    "bin/banner.js",
    "server",
    "scripts",
    "frontend/src",
    "frontend/public",
    "frontend/package.json",
    "frontend/next.config.mjs",
    "frontend/postcss.config.js",
    "frontend/tailwind.config.ts",
    "frontend/tsconfig.json",
    "frontend/.next/standalone",
    ".env.example",
    "README.md",
    "docker-compose.yml",
    "LICENSE",
    "!frontend/.next/cache/**"
  ],
  "scripts": {
    "thegate": "node ./bin/thegate.js",
    "start": "node ./bin/thegate.js start",
    "test": "node server/test.js",
    "test:live": "node server/test_live_completion.js",
    "dev:backend": "node server/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "start:frontend": "cd frontend && npm run start -- -p 3000"
  },
  "keywords": [
    "ai",
    "llm",
    "routing",
    "cost-optimization",
    "gateway",
    "finops",
    "ai-workforce",
    "thegate",
    "fastify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikalalif/thegate.git"
  },
  "bugs": {
    "url": "https://github.com/fikalalif/thegate/issues"
  },
  "homepage": "https://github.com/fikalalif/thegate#readme",
  "author": "TheGate Core Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/http-proxy": "^11.6.5",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7"
  }
}
