# TheGate environment configuration template.
# Copy to .env and adjust for local deployment.


# Application & Environment
APP_NAME=TheGate
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-secure-random-32-char-string

# Gateway Server
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database
POSTGRES_USER=thegate
POSTGRES_PASSWORD=thegate_secret_password
POSTGRES_DB=thegate_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://thegate:thegate_secret_password@db:5432/thegate_db

# Downstream Initial Provider Integration (9Router)
NINEROUTER_BASE_URL=http://localhost:8080/v1
NINEROUTER_API_KEY=your-9router-api-key-here
NINEROUTER_TIMEOUT_SECONDS=60.0

# Routing & Cost Defaults
DEFAULT_ROUTING_POLICY_MODE=balanced
DEFAULT_BASELINE_MODEL=gpt-4o
MAX_REQUEST_BODY_BYTES=2097152
RATE_LIMIT_PER_MINUTE=120

# Privacy & Logging
LOG_METADATA_ONLY=true
STORE_PROMPT_CONTENT=false

# Frontend Dashboard (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=TheGate
